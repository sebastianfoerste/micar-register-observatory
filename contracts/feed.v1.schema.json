{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sebastianfoerste/micar-register-observatory/contracts/feed.v1.schema.json",
  "title": "MiCAR Register Observatory Feed v1",
  "description": "docs/feed.json: the current register totals and the last 200 change records. Fields marked as added are missing from feeds written before October 2026. Field meanings: docs/data-dictionary.md.",
  "type": "object",
  "required": ["snapshot_date", "registers", "recent_changes"],
  "properties": {
    "snapshot_date": {"type": "string", "format": "date"},
    "quarantine": {
      "description": "Added in October 2026. The export set aside after snapshot_date, or null.",
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["snapshot_date", "shrinks"],
          "properties": {
            "snapshot_date": {"type": "string", "format": "date"},
            "shrinks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["slug", "before", "after"],
                "properties": {
                  "slug": {"type": "string"},
                  "before": {"type": "integer", "minimum": 0},
                  "after": {"type": "integer", "minimum": 0}
                }
              }
            }
          }
        }
      ]
    },
    "registers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "title", "entries", "fetched"],
        "properties": {
          "slug": {"enum": ["other-wp", "emt-wp", "art-wp", "casps", "ncasp"]},
          "title": {"type": "string"},
          "entries": {"description": "Rows of the export.", "type": "integer", "minimum": 0},
          "entities": {
            "description": "Added in October 2026. Distinct LEIs, or names where a row has none.",
            "type": "integer",
            "minimum": 0
          },
          "fetched": {"type": "boolean"},
          "source_last_modified": {
            "description": "Added in October 2026. The HTTP Last-Modified header of the export, verbatim; empty when the server sent none.",
            "type": "string"
          }
        }
      }
    },
    "recent_changes": {
      "type": "array",
      "maxItems": 200,
      "items": {"$ref": "changelog.v1.schema.json"}
    }
  }
}
